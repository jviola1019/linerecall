# Safe development defaults. Production startup rejects insecure development auth.
NODE_ENV=development
HOST=127.0.0.1
PORT=4100
PUBLIC_ORIGIN=http://127.0.0.1:5173
TRUST_PROXY=false
ALLOW_INSECURE_DEV_AUTH=false
# Required by the PostgreSQL adapter; never commit a real credential.
DATABASE_URL=postgresql://linerecall_app:replace-me@127.0.0.1:5432/linerecall
AUTH_DATABASE_URL=postgresql://linerecall_auth:replace-me@127.0.0.1:5432/linerecall
# Better Auth integration requires at least 32 random bytes supplied out of band.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:4100
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=LineRecall
MAGIC_LINK_FROM=
AUTH_MODE=dev-header
SERVICE_ORIGIN=http://127.0.0.1:4100
DATABASE_SSL_CA_FILE=
DATABASE_SSL_CA_PEM=
REDIS_URL=
AWS_REGION=us-east-1
PRIVATE_OBJECT_BUCKET=
PUBLIC_DATA_BUCKET=
CATALOG_MANIFEST_KEY=public/manifests/current.json
CATALOG_SIGNING_PUBLIC_KEY_PEM=
PRIVATE_BUCKET_KMS_KEY_ID=
BATCH_JOB_QUEUE=
BATCH_IMPORT_JOB_DEFINITION=
BATCH_STOCKFISH_JOB_DEFINITION=
BATCH_SCID_JOB_DEFINITION=
BATCH_REFRESH_JOB_DEFINITION=
LICHESS_CLIENT_ID=
TOKEN_KMS_KEY_ID=
EXTERNAL_USER_AGENT=LineRecall/0.1 (security-contact@example.invalid)
WORKER_SHUTDOWN_TIMEOUT_MS=15000
